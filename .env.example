PORT=4100
# On a hosting panel, create the database there and put its name, user and password here.
# The app creates all tables itself on first start.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=siteguard


# ---- Plan (limits how many sites can be monitored) ----
# starter = 5 sites (₹799/mo), growth = 15 sites (₹1,499/mo), agency = 50 sites (₹2,499/mo)
PLAN=starter

# ---- Monitoring ----
# Minutes between uptime checks for each site
CHECK_INTERVAL_MINUTES=5
# A site is only reported DOWN after this many failed checks in a row (avoids false alarms)
FAILURES_BEFORE_ALERT=2
# Days before SSL / domain expiry to send reminders (each sent once per renewal)
EXPIRY_REMINDER_DAYS=30,14,7,1
# Hour of the day (server time, 0-23) for the daily AI page scan
DAILY_SCAN_HOUR=6
# Max pages crawled per site in the daily scan
SCAN_MAX_PAGES=40
# Set to 0 to turn off the background scheduler (e.g. when running tests)
SCHEDULER_ENABLED=1

# ---- AI (daily page scan: outdated banners, expired dates, stale content) ----
# free = rule-based checks only, openai = any OpenAI-compatible API (OpenAI, Groq), ollama = local
AI_MODE=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2

# ---- Email alerts (any SMTP: Gmail app password, Zoho, SES, Brevo...) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SiteGuard <alerts@example.com>"
# Web team / agency inbox that gets every alert (clients get their own site's alerts too)
TEAM_EMAIL=

# ---- WhatsApp alerts ----
# twilio or meta (WhatsApp Cloud API). Leave empty to skip WhatsApp.
WHATSAPP_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
# Web team WhatsApp number, international format e.g. +919876543210
TEAM_WHATSAPP=

# ---- Monthly report branding ----
BRAND_NAME=SiteGuard
BRAND_COLOR=#0f766e
BRAND_LOGO_URL=
# Public address of this app, used for links inside emails
APP_URL=http://localhost:4100
